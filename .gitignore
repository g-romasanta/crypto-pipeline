# ============================================================
# SECRETS & CREDENTIALS — never commit these
# ============================================================
# JARGON: a .gitignore file tells Git which files/folders to NEVER track
# or upload, even if they exist in your project folder. This is your
# safety net against accidentally leaking API keys or passwords to a
# public repo.

*.json
!package.json
!package-lock.json
gcp-key.json
service-account*.json
*-key.json
.env
.env.*

# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/
ENV/

# ============================================================
# OS / EDITOR CLUTTER
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ============================================================
# LOGS
# ============================================================
*.log

# Allow the committed dataset (the *.json rule above is for secrets only)
!data/*.csv
